# Web3Forms access key for the contact form (free plan: 400 submissions/month).
# The form submits from the browser, so this key is public by design and must
# be exposed with the NEXT_PUBLIC_ prefix.
# Get a free key at https://web3forms.com by entering the destination inbox
# (ash@codio.co.in), then copy it into .env.local (which is gitignored).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY
